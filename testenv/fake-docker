#!/bin/sh
# A stand-in for the docker CLI, so the app's Docker panel can be tested without Docker in Docker.
# On "basic" it knows three containers (web, db, job), images, volumes, networks and a Compose
# project (shop), whose state survives between calls until /tmp/fake-docker is deleted;
# elsewhere it answers like a user who isn't in the docker group.
if [ "$(hostname)" != basic ]; then
  echo "permission denied while trying to connect to the Docker daemon socket at unix:///var/run/docker.sock: Get \"http://%2Fvar%2Frun%2Fdocker.sock/v1.47/containers/json\": dial unix /var/run/docker.sock: connect: permission denied" >&2
  exit 1
fi
dir=/tmp/fake-docker
if [ ! -d "$dir" ]; then
  mkdir -p "$dir"
  echo running > "$dir/web"; echo running > "$dir/db"; echo exited > "$dir/job"
  printf 'nginx:1.27\npostgres:16\nbusybox:1.36\n' > "$dir/images"
  printf 'dati\ncache\n' > "$dir/volumes"
  echo 'running(2)' > "$dir/compose"
fi

info() {
  case "$1" in
    web) id=3f2a9c1e5b7d4a6f8e0c2b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a1c3e5b7d9f1a; image=nginx:1.27; ports="0.0.0.0:8080->80/tcp" ;;
    db) id=8c4e2a6f0b1d3c5e7a9b1d3f5c7e9a1b3d5f7c9e1a3b5d7f9c1e3a5b7d9f1c3e; image=postgres:16; ports="5432/tcp" ;;
    job) id=1b7d9f3a5c7e9b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a1c3e5b7d9f1a3c5e7b9d; image=busybox:1.36; ports="" ;;
    *) return 1 ;;
  esac
}

# The container is the last argument of start, stop, restart and logs: a name, or an id or its prefix.
last() {
  for a in "$@"; do n=$a; done
  for c in web db job; do
    info "$c"
    case "$id" in "$n"*) echo "$c"; return ;; esac
  done
  echo "$n"
}

cmd=$1; shift
case "$cmd" in
  ps)
    for n in web db job; do
      [ -f "$dir/$n" ] || continue
      info "$n"; state=$(cat "$dir/$n")
      if [ "$state" = running ]; then status="Up 2 hours"; else status="Exited (0) 3 hours ago"; fi
      printf '{"Command":"\\"/entrypoint\\"","ID":"%s","Image":"%s","Names":"%s","Ports":"%s","RunningFor":"2 days ago","State":"%s","Status":"%s"}\n' \
        "$id" "$image" "$n" "$ports" "$state" "$status"
    done ;;
  stats)
    for n in web db job; do
      [ "$(cat "$dir/$n" 2>/dev/null)" = running ] || continue
      info "$n"
      printf '{"BlockIO":"1.2MB / 0B","CPUPerc":"0.%s%%","Container":"%s","ID":"%s","MemPerc":"0.30%%","MemUsage":"23.4MiB / 7.65GiB","Name":"%s","NetIO":"4.1kB / 1.3kB","PIDs":"5"}\n' \
        "$(printf %s "$n" | wc -c)7" "$(echo "$id" | cut -c1-12)" "$id" "$n"
    done ;;
  start|stop|restart)
    n=$(last "$@")
    info "$n" || { echo "Error response from daemon: No such container: $n" >&2; exit 1; }
    if [ "$cmd" = stop ]; then echo exited > "$dir/$n"; else echo running > "$dir/$n"; fi
    echo "$n" ;;
  rm)
    n=$(last "$@")
    [ -f "$dir/$n" ] || { echo "Error response from daemon: No such container: $n" >&2; exit 1; }
    if [ "$(cat "$dir/$n")" = running ]; then
      echo "Error response from daemon: cannot remove container \"/$n\": container is running: stop the container before removing or force remove" >&2; exit 1
    fi
    rm "$dir/$n"; echo "$n" ;;
  image)
    sub=$1; shift
    case "$sub" in
      ls)
        while read -r i; do
          printf '{"ID":"sha256:%s","Repository":"%s","Size":"192MB","Tag":"%s"}\n' "$(echo "$i" | cksum | cut -d' ' -f1)" "${i%%:*}" "${i##*:}"
        done < "$dir/images" ;;
      rm)
        n=$(last "$@")
        if [ "$n" = nginx:1.27 ] && [ -f "$dir/web" ]; then
          echo "Error response from daemon: conflict: unable to remove repository reference \"$n\" (must force) - container 3f2a9c1e is using its referenced image" >&2; exit 1
        fi
        grep -qx "$n" "$dir/images" || { echo "Error response from daemon: No such image: $n" >&2; exit 1; }
        grep -vx "$n" "$dir/images" > "$dir/images.new"; mv "$dir/images.new" "$dir/images"; echo "Untagged: $n" ;;
    esac ;;
  volume)
    sub=$1; shift
    case "$sub" in
      ls) while read -r v; do printf '{"Driver":"local","Name":"%s"}\n' "$v"; done < "$dir/volumes" ;;
      rm)
        n=$(last "$@")
        grep -qx "$n" "$dir/volumes" || { echo "Error response from daemon: get $n: no such volume" >&2; exit 1; }
        grep -vx "$n" "$dir/volumes" > "$dir/volumes.new"; mv "$dir/volumes.new" "$dir/volumes"; echo "$n" ;;
    esac ;;
  network)
    case "$1" in
      ls)
        printf '{"Driver":"bridge","ID":"n1","Name":"bridge","Scope":"local"}\n'
        printf '{"Driver":"bridge","ID":"n2","Name":"shop_net","Scope":"local"}\n' ;;
      rm) echo "${2:-}" ;;
    esac ;;
  compose)
    if [ -f "$dir/no-compose" ]; then echo "docker: 'compose' is not a docker command." >&2; exit 1; fi
    project=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --project-name) project=$2; shift 2 ;;
        -f) shift 2 ;;
        *) break ;;
      esac
    done
    case "$1" in
      version) echo "Docker Compose version v2.29.0" ;;
      ls) printf '[{"Name":"shop","Status":"%s","ConfigFiles":"/srv/shop/compose.yml"}]\n' "$(cat "$dir/compose")" ;;
      up) [ "$project" = shop ] && echo 'running(2)' > "$dir/compose" ;;
      down) [ "$project" = shop ] && echo 'exited(2)' > "$dir/compose" ;;
      restart) [ "$project" = shop ] && echo 'running(3)' > "$dir/compose" ;;
      *) echo "unknown compose command: $1" >&2; exit 1 ;;
    esac ;;
  logs)
    n=$(last "$@")
    info "$n" || { echo "Error response from daemon: No such container: $n" >&2; exit 1; }
    for i in 1 2 3; do echo "$n | 10:0$i GET /health 200"; done
    case " $* " in *" -f "*|*" --follow "*) while sleep 1; do echo "$n | $(date +%T) GET /health 200"; done ;; esac ;;
  exec)
    # Skip the options, then the container, and run the rest here.
    while [ $# -gt 0 ]; do case "$1" in -*) shift ;; *) break ;; esac; done
    n=$(last "$1")
    info "$n" || { echo "Error response from daemon: No such container: $1" >&2; exit 1; }
    shift
    exec "$@" ;;
  *)
    echo "docker: '$cmd' is not a docker command." >&2; exit 1 ;;
esac
